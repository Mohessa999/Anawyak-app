{
  "name": "ana-wyak",
  "version": "3.9.0",
  "description": "Ana Wyak — A luxury bilingual PWA for Arab couples in the GCC",
  "private": true,
  "scripts": {
    "dev": "npx serve . -l 3000",
    "cap:init": "npx cap init 'Ana Wyak' 'app.anawyak' --web-dir .",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "cap:build:ios": "npx cap sync ios && npx cap open ios",
    "cap:build:android": "npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/browser": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/android": "^6.0.0"
  }
}
